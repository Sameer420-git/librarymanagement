# ---------------------------------------------------------------------------
# College Library Management System - environment template
# Copy to `.env` and replace every placeholder with a real value.
# NEVER commit the filled-in .env file.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="College Library Management System"
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
# Public URL of the React frontend (used in e-mail links)
APP_BASE_URL=http://localhost:5173
# Comma separated list of allowed CORS origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Institution timezone used for due dates, reminders and reports
LIBRARY_TIMEZONE=Asia/Kolkata

# --- Database (MySQL 8) ---------------------------------------------------
# Local docker-compose credentials:
DATABASE_URL=mysql+pymysql://library:library_password@localhost:3306/library_db?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# Set to true when serving over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=library_refresh_token
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- SMTP -----------------------------------------------------------------
# Mailpit (docker compose) defaults: localhost:1025, no auth
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=library@example.edu
SMTP_FROM_NAME=College Library
SMTP_STARTTLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
# smtp | mock | console   (console prints a summary instead of sending)
EMAIL_BACKEND=console

# --- Scheduler / notifications -------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_BATCH_SIZE=50

# --- Admin bootstrap ------------------------------------------------------
# Optional: used by `python -m scripts.bootstrap_admin`
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=
